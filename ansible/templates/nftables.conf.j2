#!/usr/sbin/nft -f
# SPDX-License-Identifier: GPL-3.0-or-later
#
# {{ ansible_managed }}
# FW-HIL bench host egress firewall (defense-in-depth), scoped to the `hil` user.
#
# Rendered by ansible/tasks/egress-firewall.yml. DO NOT edit on the host — any
# manual change is overwritten on the next playbook run.
#
# Purpose: a second layer under the UniFi CI-VLAN. It fences the egress of the
# UNTRUSTED runner user `hil` (which executes PR code) so that code cannot phone
# home or reach the home LAN — allowing hil only DNS/NTP and HTTPS/HTTP to an
# allowlist. Every OTHER user (admin, root, system services: apt/NTP/…) egresses
# unrestricted; box-wide network isolation is the UniFi VLAN's job, not this.
#
# NO LOCKOUT: only hil's OUTPUT is filtered (policy accept + `meta skuid`), and
# there is no INPUT filtering at all, so admin ssh / management traffic is never
# touched.

flush ruleset

table inet fw_hil_egress {
    # GitHub's own published IP ranges (api.github.com/meta), materialized at
    # apply time. Snapshot — a playbook re-run refreshes it. See README for the
    # staleness caveat and why CDN-hosted destinations cannot live here.
    set github_egress_v4 {
        type ipv4_addr
        flags interval
{% if github_egress_v4 | length > 0 %}
        elements = {
            {{ github_egress_v4 | join(',\n            ') }}
        }
{% endif %}
    }

    set github_egress_v6 {
        type ipv6_addr
        flags interval
{% if github_egress_v6 | length > 0 %}
        elements = {
            {{ github_egress_v6 | join(',\n            ') }}
        }
{% endif %}
    }

    # Operator-extensible static allowlist for destinations that have no meta
    # API (e.g. explicit PyPI/Fastly or distro-mirror CIDRs). Set via the
    # `egress_extra_cidrs_v4` / `_v6` playbook vars. Empty by default.
    set extra_egress_v4 {
        type ipv4_addr
        flags interval
{% if egress_extra_cidrs_v4 | length > 0 %}
        elements = {
            {{ egress_extra_cidrs_v4 | join(',\n            ') }}
        }
{% endif %}
    }

    set extra_egress_v6 {
        type ipv6_addr
        flags interval
{% if egress_extra_cidrs_v6 | length > 0 %}
        elements = {
            {{ egress_extra_cidrs_v6 | join(',\n            ') }}
        }
{% endif %}
    }

    # Configured DNS resolver(s) — restricts hil's outbound port 53 so the
    # untrusted process can't DNS-tunnel to an arbitrary external resolver.
    # Effective upstreams (systemd-resolved stub resolved to real upstreams,
    # loopback stripped). Tunneling *via* the legitimate recursive resolver is
    # still possible — inherent to DNS, out of scope for a host firewall; the
    # VLAN is the real control.
    set dns_servers_v4 {
        type ipv4_addr
{% if egress_dns_v4 | length > 0 %}
        elements = { {{ egress_dns_v4 | join(', ') }} }
{% endif %}
    }

    set dns_servers_v6 {
        type ipv6_addr
{% if egress_dns_v6 | length > 0 %}
        elements = { {{ egress_dns_v6 | join(', ') }} }
{% endif %}
    }

    # Only the OUTPUT hook is filtered, and only for the `hil` user. No input or
    # forward chains: this table exists solely to fence hil's egress.
    chain output {
        type filter hook output priority filter; policy accept;

        # Fast path: everything NOT owned by hil (admin, root, system daemons)
        # egresses unrestricted. `meta skuid` is the socket owner UID and is only
        # meaningful for locally generated traffic — exactly this hook.
        meta skuid != {{ egress_hil_uid }} accept

        # ── below here: only hil's locally-generated traffic ──────────────────
        oif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ICMPv6: only the control-message types IPv6 needs to egress (NDP, MLD,
        # PMTU/errors). echo-request is deliberately NOT allowed, so hil can't
        # tunnel data out via ping to an unallowlisted host.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-report, mld-listener-done, mld2-listener-report } accept

        # Name resolution: restricted to the effective upstream resolver(s) when
        # known, otherwise any (no resolvers discoverable). On systemd-resolved
        # hil talks to the 127.0.0.53 stub over loopback (accepted above); the
        # real upstream forwarding is done by root, which is unrestricted.
{% if (egress_dns_v4 | length + egress_dns_v6 | length) > 0 %}
        ip  daddr @dns_servers_v4 udp dport 53 accept
        ip  daddr @dns_servers_v4 tcp dport 53 accept
        ip6 daddr @dns_servers_v6 udp dport 53 accept
        ip6 daddr @dns_servers_v6 tcp dport 53 accept
{% else %}
        udp dport 53 accept
        tcp dport 53 accept
{% endif %}

        # Time sync (NTP servers rotate — pinning is impractical; NTP is a poor
        # exfil channel and the VLAN bounds it).
        udp dport 123 accept

        # HTTPS/HTTP only to allowlisted destinations.
        ip  daddr @github_egress_v4 tcp dport { 80, 443 } accept
        ip6 daddr @github_egress_v6 tcp dport { 80, 443 } accept
        ip  daddr @extra_egress_v4  tcp dport { 80, 443 } accept
        ip6 daddr @extra_egress_v6  tcp dport { 80, 443 } accept

        # hil's remaining egress — the home LAN, arbitrary internet hosts — is
        # dropped. (Non-hil traffic already returned via the fast path above.)
        drop
    }
}
