# SPDX-License-Identifier: GPL-3.0-or-later
#
# udev rules for the OE5XRX FM-Board USB Composite device (CDC-ACM serial port).
#
# VID: 0x2fe3  PID: 0x0012  (Zephyr USB_DEVICE_STACK_NEXT composite on STM32U575)
#
# Creates a stable /dev/fm-board-cdc symlink so twister and fw_hil can address the
# board console without relying on the enumeration-order-dependent /dev/ttyACMx path.
#
# If multiple boards are connected simultaneously, extend with ATTRS{serial}=="..."
# (board iSerial from `lsusb -v -d 2fe3:0012 | grep iSerial`) and use distinct names.

SUBSYSTEM=="tty", ATTRS{idVendor}=="2fe3", ATTRS{idProduct}=="0012", GROUP="dialout", MODE="0664", SYMLINK+="fm-board-cdc"

# Raw USB device access for dfu-util (DFU download) and pyusb (descriptor reads
# / UAC2 clock) as the bench user via plugdev — in both run-time and DFU mode
# (same VID/PID). Without this only root can drive the DFU/USB-enum bausteine.
SUBSYSTEM=="usb", ATTR{idVendor}=="2fe3", ATTR{idProduct}=="0012", GROUP="plugdev", MODE="0664"
